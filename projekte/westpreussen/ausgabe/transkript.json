{
 "modell": "medium",
 "dauer": 176.58775,
 "saetze": [
  {
   "von": 0.0,
   "bis": 1.06,
   "text": "West Prussia."
  },
  {
   "von": 1.4,
   "bis": 3.46,
   "text": "A land shaped by history."
  },
  {
   "von": 4.16,
   "bis": 11.94,
   "text": "A land between Germany and Poland, shaped by centuries of changing borders, different cultures, and unforgettable events."
  },
  {
   "von": 12.58,
   "bis": 20.22,
   "text": "Today, much of this historic region lies within modern Poland, but its story goes back much further than the borders we know today."
  },
  {
   "von": 20.84,
   "bis": 27.62,
   "text": "Long before the name West Prussia existed, the region was home to Baltic peoples known as the Old Prussians."
  },
  {
   "von": 28.14,
   "bis": 35.22,
   "text": "In the 13th century, the Teutonic order began expanding into these lands, building castles, towns, and settlements."
  },
  {
   "von": 35.84,
   "bis": 41.62,
   "text": "One of its greatest strongholds was Marienburg, which became the order's headquarters in 1309."
  },
  {
   "von": 41.98,
   "bis": 44.54,
   "text": "But the order's power did not last forever."
  },
  {
   "von": 45.04,
   "bis": 51.5,
   "text": "After years of conflict, the second piece of thorn in 1466 divided its former territories."
  },
  {
   "von": 51.5,
   "bis": 56.16,
   "text": "The western part became royal Prussia, connected to the Polish crown."
  },
  {
   "von": 56.82,
   "bis": 62.2,
   "text": "Cities such as Danzig, Thorn, and Elbing became important centers of trade and culture."
  },
  {
   "von": 62.88,
   "bis": 66.42,
   "text": "More than 300 years later, everything changed again."
  },
  {
   "von": 66.86,
   "bis": 73.28,
   "text": "During the first partition of Poland in 1772, Prussia took control of large parts of the region."
  },
  {
   "von": 73.7,
   "bis": 76.16,
   "text": "The province of West Prussia was established."
  },
  {
   "von": 76.8,
   "bis": 79.84,
   "text": "Danzig and Thorn followed in 1793."
  },
  {
   "von": 80.66,
   "bis": 87.86,
   "text": "Over time, Germans, Poles, Kashubians, and Jewish communities helped shape everyday life in this diverse region."
  },
  {
   "von": 88.38,
   "bis": 92.6,
   "text": "Different languages, traditions, and religions existed side by side."
  },
  {
   "von": 93.22,
   "bis": 95.26,
   "text": "Then came the First World War."
  },
  {
   "von": 95.74,
   "bis": 98.92,
   "text": "Germany's defeat changed the map of Europe once again."
  },
  {
   "von": 99.38,
   "bis": 104.9,
   "text": "Under the Treaty of Versailles in 1919, most of West Prussia was transferred to Poland."
  },
  {
   "von": 104.9,
   "bis": 111.1,
   "text": "Danzig became a free city under international supervision, while some territories remained German."
  },
  {
   "von": 111.58,
   "bis": 115.86,
   "text": "In 1920, the old province of West Prussia ceased to exist."
  },
  {
   "von": 116.42,
   "bis": 119.24,
   "text": "But the story of this land was far from over."
  },
  {
   "von": 119.84,
   "bis": 124.44,
   "text": "On September 1, 1939, Nazi Germany invaded Poland."
  },
  {
   "von": 124.88,
   "bis": 128.88,
   "text": "The region was occupied, and large parts were annexed to the German Reich."
  },
  {
   "von": 129.38,
   "bis": 131.78,
   "text": "What followed was a period of terror."
  },
  {
   "von": 131.78,
   "bis": 135.74,
   "text": "Polish civilians were imprisoned, expelled, and murdered."
  },
  {
   "von": 136.22,
   "bis": 141.2,
   "text": "The Jewish population was persecuted and almost entirely destroyed in the Holocaust."
  },
  {
   "von": 141.96,
   "bis": 147.62,
   "text": "As the Second World War came to an end in 1945, the region changed once again."
  },
  {
   "von": 148.02,
   "bis": 150.7,
   "text": "Many German inhabitants fled or were expelled."
  },
  {
   "von": 151.24,
   "bis": 155.48,
   "text": "Polish settlers arrived, and the towns and villages took on a new identity."
  },
  {
   "von": 155.78,
   "bis": 166.76,
   "text": "Today, traces of the old West Prussia can still be found in the streets of Gdańsk, in the walls of Malbork Castle, and in countless archives, cemeteries, and family memories."
  },
  {
   "von": 167.4,
   "bis": 168.84,
   "text": "Its borders have disappeared."
  },
  {
   "von": 169.4,
   "bis": 170.78,
   "text": "Its history has not."
  },
  {
   "von": 171.46,
   "bis": 173.48,
   "text": "This was West Prussia."
  },
  {
   "von": 173.98,
   "bis": 174.64,
   "text": "Zeit spüren."
  },
  {
   "von": 175.16,
   "bis": 176.32,
   "text": "History that remains."
  }
 ],
